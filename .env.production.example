# Copy to `.env.production` on the VPS only — never commit secrets.
# Local dev uses `.env` + root `docker-compose.yml` (PostGIS/Qdrant/Redis on localhost).
# See docs/steps/blueprint_production.md and OpenSpec change `production-vps-deploy`.
#
# UNUSED BY APP (do not rely on these Settings keys):
#   EMBEDDING_MODEL, UPSTASH_REDIS_REST_TOKEN, SUPABASE_* — use PLACES_EMBEDDING_* and REDIS_URL below.
#
# EMBEDDING DIM CUTOVER: dev MiniLM = 384-d; prod hosted Gemini = 768-d.
# Use QDRANT_PLACES_COLLECTION=places_v2 and reindex after switching to hosted embeddings.

# --- Compose / ops (not Settings — used by Caddy + ops/*.sh) ---
WANDR_API_HOST=api.example.com
# Set by CI or ops/deploy.sh; local manual default:
# WANDR_IMAGE=wandr-api:prod
# WANDR_GHCR_OWNER=your-github-org-or-user

# Core
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-me-strong-random

# Database — MUST use postgresql+asyncpg:// (not plain postgresql://)
# Supabase: enable PostGIS; prefer direct connection for Alembic/migrate (pooler can break DDL).
# Example direct: postgresql+asyncpg://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/wandr

# Vector search — Qdrant Cloud (not localhost)
QDRANT_URL=https://your-cluster.region.aws.cloud.qdrant.io
QDRANT_API_KEY=change-me
QDRANT_PLACES_COLLECTION=places_v2
QDRANT_PLACES_COLLECTION_V2=places_v2
SEARCH_SPARSE_ENABLED=true
SEARCH_RRF_K=60
SEARCH_FUSION_DIAGNOSTICS=true

# Hosted embeddings (no MiniLM/torch on VPS)
PLACES_EMBEDDING_BACKEND=hosted
PLACES_EMBEDDING_MODEL=gemini/text-embedding-004
PLACES_EMBEDDING_DIM=768
QDRANT_OPERATION_TIMEOUT_SECONDS=5.0
QDRANT_OPERATION_MAX_RETRIES=2
PLACES_EMBEDDING_MODEL_LOAD_TIMEOUT_SECONDS=120.0
ENRICH_BATCH_LLM_CONCURRENCY=3
GEMINI_API_KEY=change-me

# Redis — MUST be redis:// or rediss:// (Upstash "Redis" tab, NOT the HTTPS REST URL)
# Example: rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=rediss://default:change-me@your-host.upstash.io:6379
REDIS_CONNECT_TIMEOUT_SECONDS=1.0
REDIS_SOCKET_TIMEOUT_SECONDS=1.0

# LLM — provider-agnostic via LiteLLM
LLM_MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
LLM_API_KEY=change-me
LLM_API_BASE=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=4

# Planner — prod timeouts higher than code defaults (45s / 20s)
PLANNER_MAX_TOOL_CALLS=12
PLANNER_MAX_REPLAN_ATTEMPTS=2
PLANNER_GENERATION_TIMEOUT_SECONDS=300
PLANNER_MIN_READINESS_SCORE=0.3
PLANNER_AGENT_PHASE_STUCK_LIMIT=3
PLANNER_ABSOLUTE_MIN_PLACES=10
PLANNER_CACHE_TTL_SECONDS=3600

# Observability (optional — empty keys = no-op tracer)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Geo
NOMINATIM_USER_AGENT=wandr-prod/0.1 (contact@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
SEARCH_GEOCODE_TIMEOUT_SECONDS=8.0
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_MATRIX_MAX_CONCURRENCY=8
ROUTING_BACKEND=haversine
PLACES_SOURCES=overpass,opentripmap,geoapify
OPENTRIPMAP_API_KEY=
OPENTRIPMAP_BASE_URL=https://api.opentripmap.com/0.1/en
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com/v2

# Auth / Google OAuth — HTTPS API callback required in production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/callback
FRONTEND_URL=https://tripai-stagging.vercel.app

# Rate limiting (Redis backend when REDIS_URL set)
RATE_LIMIT_DEFAULT_REQUESTS=60
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_PLANNER_REQUESTS=10
RATE_LIMIT_PLANNER_WINDOW_SECONDS=60
RATE_LIMIT_PLANNER_PATH=/api/v1/planner/generate
RATE_LIMIT_DESTINATIONS_SEARCH_REQUESTS=20
RATE_LIMIT_DESTINATIONS_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_DESTINATIONS_SEARCH_PATH=/api/v1/destinations/search
RATE_LIMIT_TRIP_EDIT_REQUESTS=20
RATE_LIMIT_TRIP_EDIT_WINDOW_SECONDS=60
RATE_LIMIT_DESTINATIONS_PREPARE_REQUESTS=5
RATE_LIMIT_DESTINATIONS_PREPARE_WINDOW_SECONDS=60
DESTINATIONS_PREPARE_LOCK_TTL_SECONDS=180
DESTINATIONS_PREPARE_DEFAULT_RADIUS_KM=30.0
DESTINATIONS_PREPARE_MAX_RADIUS_KM=50.0

# CORS — explicit origins only; no trailing slash on origins
CORS_ALLOWED_ORIGINS=["https://tripai-stagging.vercel.app"]
