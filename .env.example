# Copy to local `.env` / `.env.production`; never commit those files.
# Core
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me

# Database — host tools (pytest, scripts, optional host uvicorn) use published ports.
# Compose `api` service overrides this to postgres:5432 (do not change host .env for Docker).
DATABASE_URL=postgresql+asyncpg://wandr:wandr@localhost:5433/wandr

# Vector search — host tools use published :6335; Compose `api` overrides to qdrant:6333
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=
QDRANT_PLACES_COLLECTION=places
# local = MiniLM in-process (dev default); hosted = LiteLLM (prod — use gemini/text-embedding-004 + dim 768)
PLACES_EMBEDDING_BACKEND=local
PLACES_EMBEDDING_DIM=384
QDRANT_OPERATION_TIMEOUT_SECONDS=5.0
QDRANT_OPERATION_MAX_RETRIES=2
PLACES_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PLACES_EMBEDDING_MODEL_LOAD_TIMEOUT_SECONDS=120.0
ENRICH_BATCH_LLM_CONCURRENCY=3
# LiteLLM gemini/* embeddings (and Gemini chat if used) — required when PLACES_EMBEDDING_BACKEND=hosted
GEMINI_API_KEY=

# Cache / rate-limit backends — empty REDIS_URL keeps in-memory (host pytest default).
# Compose `api` overrides to redis://redis:6379/0. Optional host uvicorn: redis://localhost:6380/0
REDIS_URL=
REDIS_CONNECT_TIMEOUT_SECONDS=1.0
REDIS_SOCKET_TIMEOUT_SECONDS=1.0

# LLM — provider-agnostic via LiteLLM (env-only swap; no code changes)
# Active example: NVIDIA NIM free-tier-friendly model
LLM_MODEL=nvidia_nim/meta/llama-3.1-8b-instruct
LLM_API_KEY=change-me
LLM_API_BASE=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=4
# Alternate providers (comment active block; set matching key/base):
# LLM_MODEL=gemini/gemini-2.0-flash
# LLM_API_KEY=change-me
# LLM_API_BASE=
# LLM_MODEL=groq/llama3-8b-8192
# LLM_API_KEY=change-me
# LLM_API_BASE=
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=change-me
# LLM_API_BASE=

# Planner agent bounds
PLANNER_MAX_TOOL_CALLS=12
PLANNER_MAX_REPLAN_ATTEMPTS=2
PLANNER_GENERATION_TIMEOUT_SECONDS=45
PLANNER_MIN_READINESS_SCORE=0.3
PLANNER_AGENT_PHASE_STUCK_LIMIT=3

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Geo
NOMINATIM_USER_AGENT=wandr-dev/0.1 (contact@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org
# Pairwise travel_matrix concurrency (public OSRM-safe default; raise for self-hosted)
OSRM_MATRIX_MAX_CONCURRENCY=8
# Generate/edit routing: haversine = in-process (default, fits 45s ceiling, no map lines);
# osrm = live OSRM_BASE_URL (use when you have a fast/paid/self-hosted router).
ROUTING_BACKEND=haversine

# Auth / Google OAuth (empty client id → /auth/google returns not-configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Rate limiting (in-memory; Redis backend at P6)
RATE_LIMIT_DEFAULT_REQUESTS=60
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_PLANNER_REQUESTS=10
RATE_LIMIT_PLANNER_WINDOW_SECONDS=60
RATE_LIMIT_DESTINATIONS_SEARCH_REQUESTS=20
RATE_LIMIT_DESTINATIONS_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_DESTINATIONS_SEARCH_PATH=/api/v1/destinations/search

# CORS (JSON list for pydantic-settings; never use "*" with credentials)
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# =============================================================================
# PRODUCTION CHECKLIST (VPS API + hosted services) — fill on the server / secrets
# See docs/steps/blueprint_production.md
# =============================================================================
# ENVIRONMENT=production
# DEBUG=false
# SECRET_KEY=<strong-random>
# DATABASE_URL=postgresql+asyncpg://...@<hosted-postgis>/...
# QDRANT_URL=https://...qdrant.io
# QDRANT_API_KEY=<qdrant-cloud-key>
# QDRANT_PLACES_COLLECTION=places   # or places_v2 after dim cutover
# PLACES_EMBEDDING_BACKEND=hosted
# PLACES_EMBEDDING_MODEL=gemini/text-embedding-004
# PLACES_EMBEDDING_DIM=768
# GEMINI_API_KEY=<google-ai-studio-key>
# REDIS_URL=rediss://...            # Upstash or equivalent
# LLM_MODEL=...
# LLM_API_KEY=...
# LLM_API_BASE=...                  # if required by provider
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=https://<api-host>/api/v1/auth/callback
# CORS_ALLOWED_ORIGINS=["https://<app-host>"]
# NOMINATIM_USER_AGENT=wandr-prod/0.1 (contact@example.com)
